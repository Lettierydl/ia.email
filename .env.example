# Cliente OAuth tipo Desktop no Google Cloud (Gmail API ligada).
# Nao commitar o .env. Copie para .env nesta pasta.

GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=

# Opcional: JSON Desktop baixado do GCP
# RADAR_GMAIL_OAUTH_CREDENTIALS=/caminho/gmail-oauth.keys.json

RADAR_ACCOUNT=leo@confrapag.com.br
RADAR_HOST=127.0.0.1
RADAR_PORT=8765

# ── LLM (resumo, rascunho, análise) ──
# Preencha uma ou mais chaves. Sem RADAR_LLM_PROVIDER, a ordem de preferência
# automática é: Claude > Gemini > OpenRouter (a primeira chave presente vence).
# RADAR_LLM_PROVIDER=anthropic   # force: anthropic | gemini | openrouter

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
